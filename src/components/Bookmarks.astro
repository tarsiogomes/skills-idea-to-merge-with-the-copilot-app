---
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="url"
      spellcheck="false"
      placeholder="example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL with or without <code>https://</code> to generate its short <code>mona-</code> slug.</p>
<p id="status" class="status" role="status" aria-live="polite"></p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>

<script>
  import {
    generateSlug,
    loadBookmarks,
    normalizeUrl,
    type Bookmark,
  } from '../lib/bookmarks.ts';

  const storageKey = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const urlInput = document.getElementById('url') as HTMLInputElement | null;
  const status = document.getElementById('status');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const list = document.getElementById('bookmark-list');
  const clearAll = document.getElementById('clear-all');
  let bookmarks: Bookmark[] = [];

  function announce(message: string) {
    if (status) status.textContent = message;
  }

  function render() {
    if (!list || !emptyState || !listHeader) return;

    list.replaceChildren();
    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const entry = document.createElement('span');
      entry.className = 'bookmark-entry';
      entry.append(link, document.createTextNode(' :: '), slug);

      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy slug';
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          announce('Slug copied to clipboard.');
        } catch {
          announce('Could not copy the slug. Select and copy it manually.');
        }
      });

      item.append(entry, copy);
      list.append(item);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  try {
    bookmarks = loadBookmarks(window.localStorage.getItem(storageKey));
  } catch {
    announce('Browser storage is unavailable. Bookmarks cannot be saved on this device.');
  }
  render();

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const url = normalizeUrl(urlInput?.value ?? '');
    if (!url) {
      announce('Enter a valid http or https URL.');
      urlInput?.focus();
      return;
    }

    let slug = generateSlug();
    let attempts = 0;
    while (bookmarks.some((bookmark) => bookmark.slug === slug) && attempts < 10) {
      slug = generateSlug();
      attempts += 1;
    }
    if (bookmarks.some((bookmark) => bookmark.slug === slug)) {
      announce('Could not create a unique slug. Please try again.');
      return;
    }

    const updated = [...bookmarks, { url, slug }];
    try {
      window.localStorage.setItem(storageKey, JSON.stringify(updated));
    } catch {
      announce('Could not save this bookmark to browser storage.');
      return;
    }

    bookmarks = updated;
    render();
    form.reset();
    announce(`Saved ${url} as ${slug}.`);
  });

  clearAll?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;

    try {
      window.localStorage.removeItem(storageKey);
    } catch {
      announce('Could not clear bookmarks from browser storage.');
      return;
    }

    bookmarks = [];
    render();
    announce('All bookmarks cleared.');
  });
</script>
